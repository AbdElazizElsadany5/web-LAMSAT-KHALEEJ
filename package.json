{
  "name": "lamsat-khaleeji-pos",
  "version": "1.0.0",
  "description": "نظام إدارة صالون الحلاقة الرجالي الفاخر - لمسة خليجي",
  "author": "لمسة خليجي | Lamsat Khaleeji",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "electron:dev": "electron .",
    "electron:build": "vite build && electron-builder --win",
    "build:exe": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.lamsatkhaleeji.pos",
    "productName": "لمسة خليجي - Lamsat Khaleeji",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "لمسة خليجي POS",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
